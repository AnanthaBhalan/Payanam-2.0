# Payanam Ã¢â‚¬â€ host-port overrides
#
# Copy to `.env` and edit only the values you need:
#     cp .env.example .env
#     docker compose up -d
#
# Every variable has a default in docker-compose.yml, so an empty `.env`
# behaves exactly like the previous hard-coded stack.
#
# WHY THIS EXISTS
# ---------------
# Host ports are a shared, global resource. Another project on the same machine
# may already own 3000, 7687, 9092 or 9644 Ã¢â‚¬â€ `docker compose up` then fails with
# "port is already allocated". Shifting the host side keeps Payanam fully
# isolated without editing the compose file.
#
# The right-hand side of every mapping is the *container* port and never
# changes. Only the host side moves. Services inside the compose network
# therefore always talk over the canonical ports and internal hostnames
# (`memgraph:7687`, `redis:6379`, `redpanda:9092`, `temporal:7233`); you do NOT
# need to change any application setting when you move a host port.

# --- Memgraph (Bolt + Lab + metrics) ---------------------------------------
# 7687 is the Bolt endpoint the neo4j driver speaks; 3000 is the Lab web UI.
# Example collision: another stack running Memgraph on 7687/3000.
MEMGRAPH_BOLT_HOST_PORT=7687
MEMGRAPH_LAB_HOST_PORT=3000
MEMGRAPH_METRICS_HOST_PORT=9090

# --- Redis (fleet geospatial index) ----------------------------------------
REDIS_HOST_PORT=6379

# --- Redpanda (Kafka + admin) ----------------------------------------------
# 9092 is the PLAINTEXT broker port; 9644 is the admin HTTP API.
REDPANDA_KAFKA_HOST_PORT=9092
REDPANDA_ADMIN_HOST_PORT=9644

# --- Temporal + Postgres ----------------------------------------------------
TEMPORAL_GRPC_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
POSTGRES_HOST_PORT=5432

# --- API + Ray --------------------------------------------------------------
API_HOST_PORT=8000
# Ray's GCS defaults to 6380 rather than 6379 so it cannot collide with Redis
# on the host while both keep 6379 inside the compose network. The Ray *Client*
# port (10001) is what RAY_ADDRESS targets; 6379 is only for worker join.
RAY_GCS_HOST_PORT=6380
RAY_CLIENT_HOST_PORT=10001
RAY_DASHBOARD_HOST_PORT=8265

# --- STARTUP RESILIENCE -----------------------------------------------------
# How long the API waits for Memgraph / Temporal / Redis before giving up, and
# how long it sleeps between attempts. Raise these on a cold, slow machine.
STARTUP_MAX_ATTEMPTS=30
STARTUP_BACKOFF_SECONDS=2.0

# --- EXAMPLE: fully isolated profile ----------------------------------------
# With another project holding 3000/7687/9092/9644/6379, use something like:
#
#   MEMGRAPH_BOLT_HOST_PORT=7690
#   MEMGRAPH_LAB_HOST_PORT=3001
#   MEMGRAPH_METRICS_HOST_PORT=9091
#   REDIS_HOST_PORT=6389
#   REDPANDA_KAFKA_HOST_PORT=9095
#   REDPANDA_ADMIN_HOST_PORT=9645
#   POSTGRES_HOST_PORT=5433
#   TEMPORAL_GRPC_HOST_PORT=7234
#   TEMPORAL_UI_HOST_PORT=8234
#   API_HOST_PORT=8001
#   RAY_GCS_HOST_PORT=6381
#   RAY_DASHBOARD_HOST_PORT=8266
#   RAY_CLIENT_HOST_PORT=10002
#
# Then reach them at:
#   API          http://localhost:8001/health
#   Memgraph Lab http://localhost:3001
#   Temporal UI  http://localhost:8234
#   Ray          http://localhost:8266
#
# From your host, point the app at the shifted Bolt/Redis ports:
#   MEMGRAPH_URI=bolt://localhost:7690
#   REDIS_URL=redis://localhost:6389/0